{
  "toast": "agent-toast",
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "space-folders"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents-ctx"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "topbar",
          "type": "row",
          "size": {
            "px": 42
          },
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "tabs"
              },
              "window_drag": true,
              "size": {
                "weight": 1
              }
            },
            {
              "id": "layout-switch",
              "type": "block",
              "size": {
                "px": 176
              },
              "window_drag": true,
              "content": {
                "mod": "layout-switch",
                "props": {
                  "labels": {
                    "overview": "Overview",
                    "focus": "Focus"
                  },
                  "order": [
                    "overview",
                    "focus"
                  ],
                  "hide": [
                    "main",
                    "win98",
                    "terminals"
                  ],
                  "panel": "panel"
                }
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "inspector",
                  "header": {
                    "content": {
                      "mod": "stack-tabs",
                      "props": {
                        "stack": "panel-body",
                        "labels": {
                          "files": "Files",
                          "changes": "Changes",
                          "git": "Git graph",
                          "prs": "Pull requests",
                          "inspector": "Agent inspector"
                        },
                        "sync_panels": true,
                        "hide": [
                          "changes"
                        ]
                      }
                    },
                    "height": 36
                  },
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes-plus"
                      }
                    },
                    {
                      "id": "git",
                      "type": "block",
                      "content": {
                        "mod": "git-graph"
                      }
                    },
                    {
                      "id": "prs",
                      "type": "block",
                      "content": {
                        "mod": "pr-panel",
                        "props": {
                          "reveal": {
                            "panel": "panel",
                            "stack": "panel-body",
                            "child": "prs"
                          }
                        }
                      }
                    },
                    {
                      "id": "inspector",
                      "type": "block",
                      "content": {
                        "mod": "agent-inspector"
                      }
                    }
                  ]
                }
              ],
              "size": {
                "px": 440
              },
              "min": 300,
              "max": 900,
              "hidden": false,
              "radius": 10,
              "border": {
                "width": 1,
                "color": "border"
              }
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status-row",
          "type": "row",
          "size": {
            "px": 28
          },
          "resizable": false,
          "children": [
            {
              "id": "status",
              "type": "block",
              "size": {
                "weight": 1
              },
              "content": {
                "mod": "workspace-status"
              }
            },
            {
              "id": "worktrees",
              "type": "block",
              "size": {
                "px": 230
              },
              "content": {
                "mod": "worktrees",
                "props": {
                  "view": "pill"
                }
              }
            },
            {
              "id": "usage",
              "type": "block",
              "size": {
                "px": 900
              },
              "content": {
                "mod": "usage-bar"
              }
            }
          ]
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}