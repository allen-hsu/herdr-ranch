{
  "toast": "agent-toast",
  "id": "root",
  "type": "column",
  "children": [
    {
      "id": "body",
      "type": "row",
      "divider": {
        "width": 1,
        "color": "border"
      },
      "resizable": false,
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "children": [
            {
              "id": "brand",
              "type": "block",
              "content": {
                "mod": "workspace-chrome"
              },
              "size": {
                "px": 46
              },
              "window_drag": true
            },
            {
              "id": "sidebar-search",
              "type": "block",
              "size": {
                "px": 36
              },
              "content": {
                "mod": "sidebar-foot",
                "props": {
                  "search": true
                }
              }
            },
            {
              "id": "sidebar-view",
              "type": "stack",
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "content": {
                    "mod": "space-folders"
                  }
                },
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "agents-ctx"
                  }
                }
              ],
              "active": "spaces"
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "content": {
                "mod": "sidebar-foot"
              },
              "size": {
                "px": 76
              }
            }
          ],
          "size": {
            "px": 268
          },
          "min": 44,
          "max": 480,
          "background": "chrome",
          "resizable": false
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "topbar",
              "type": "row",
              "size": {
                "px": 42
              },
              "resizable": false,
              "children": [
                {
                  "id": "tabs",
                  "type": "block",
                  "content": {
                    "mod": "tabs-plus",
                    "props": {
                      "panel_buttons": false
                    }
                  },
                  "window_drag": true,
                  "size": {
                    "weight": 1
                  }
                },
                {
                  "id": "layout-switch",
                  "type": "block",
                  "size": {
                    "px": 46
                  },
                  "window_drag": true,
                  "content": {
                    "mod": "layout-switch",
                    "props": {
                      "labels": {
                        "overview": "Overview",
                        "focus": "Focus"
                      },
                      "order": [
                        "overview",
                        "focus"
                      ],
                      "hide": [
                        "focus",
                        "main",
                        "overview",
                        "terminals",
                        "win98"
                      ],
                      "panel": "panel"
                    }
                  }
                }
              ]
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 8,
                      "radius": 10,
                      "background": "background",
                      "lone": true,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "height": 30,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "active": "inspector",
                      "header": {
                        "content": {
                          "mod": "stack-tabs",
                          "props": {
                            "stack": "panel-body",
                            "labels": {
                              "files": "Files",
                              "inspector": "Inspector",
                              "changes": "Changes",
                              "prs": "Pull requests",
                              "git": "Git graph"
                            },
                            "sync_panels": true,
                            "icons": {
                              "files": "files",
                              "inspector": "gauge",
                              "changes": "file-diff",
                              "prs": "git-pull-request",
                              "git": "history"
                            }
                          }
                        },
                        "height": 38
                      },
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files-plus"
                          }
                        },
                        {
                          "id": "inspector",
                          "type": "block",
                          "content": {
                            "mod": "agent-inspector"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes-plus"
                          }
                        },
                        {
                          "id": "prs",
                          "type": "block",
                          "content": {
                            "mod": "pr-panel",
                            "props": {
                              "reveal": {
                                "panel": "panel",
                                "stack": "panel-body",
                                "child": "prs"
                              }
                            }
                          }
                        },
                        {
                          "id": "git",
                          "type": "block",
                          "content": {
                            "mod": "git-graph"
                          }
                        }
                      ]
                    }
                  ],
                  "size": {
                    "px": 440
                  },
                  "min": 300,
                  "max": 900,
                  "hidden": false,
                  "radius": 10,
                  "border": {
                    "width": 1,
                    "color": "border"
                  }
                }
              ],
              "padding": 8,
              "gap": 8
            }
          ],
          "resizable": false
        }
      ]
    },
    {
      "id": "status-row",
      "type": "row",
      "size": {
        "px": 28
      },
      "resizable": false,
      "children": [
        {
          "id": "status",
          "type": "block",
          "size": {
            "weight": 1
          },
          "content": {
            "mod": "workspace-status"
          }
        },
        {
          "id": "worktrees",
          "type": "block",
          "size": {
            "px": 230
          },
          "content": {
            "mod": "worktrees",
            "props": {
              "view": "pill"
            }
          }
        },
        {
          "id": "usage",
          "type": "block",
          "size": {
            "px": 900
          },
          "content": {
            "mod": "usage-bar"
          }
        }
      ],
      "background": "chrome"
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "resizable": false
}
