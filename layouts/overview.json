{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "space-folders"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "topbar",
          "type": "row",
          "size": {
            "px": 42
          },
          "resizable": false,
          "children": [
            {
              "id": "drag",
              "type": "block",
              "size": {
                "weight": 1
              },
              "window_drag": true,
              "content": {
                "mod": "title-strip"
              }
            },
            {
              "id": "layout-switch",
              "type": "block",
              "size": {
                "px": 176
              },
              "window_drag": true,
              "content": {
                "mod": "layout-switch",
                "props": {
                  "labels": {
                    "overview": "Overview",
                    "focus": "Focus"
                  },
                  "order": [
                    "overview",
                    "focus"
                  ],
                  "hide": [
                    "main",
                    "win98",
                    "terminals"
                  ],
                  "panel": "side"
                }
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "board",
              "type": "block",
              "radius": 10,
              "content": {
                "mod": "agent-board",
                "props": {
                  "open_layout": "focus"
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            },
            {
              "id": "side",
              "type": "stack",
              "size": {
                "px": 420
              },
              "min": 300,
              "max": 760,
              "radius": 10,
              "border": {
                "width": 1,
                "color": "border"
              },
              "header": {
                "content": {
                  "mod": "stack-tabs",
                  "props": {
                    "stack": "side",
                    "labels": {
                      "prs": "Pull requests",
                      "inspector": "Agent inspector",
                      "git": "Git graph"
                    }
                  }
                },
                "height": 36
              },
              "active": "prs",
              "children": [
                {
                  "id": "prs",
                  "type": "block",
                  "content": {
                    "mod": "pr-panel"
                  }
                },
                {
                  "id": "inspector",
                  "type": "block",
                  "content": {
                    "mod": "agent-inspector"
                  }
                },
                {
                  "id": "git",
                  "type": "block",
                  "content": {
                    "mod": "git-graph"
                  }
                }
              ]
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status-row",
          "type": "row",
          "size": {
            "px": 28
          },
          "resizable": false,
          "children": [
            {
              "id": "status",
              "type": "block",
              "size": {
                "weight": 1
              },
              "content": {
                "mod": "workspace-status"
              }
            },
            {
              "id": "usage",
              "type": "block",
              "size": {
                "px": 900
              },
              "content": {
                "mod": "usage-bar"
              }
            }
          ]
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}